<?xml version='1.0' encoding='utf-8'?>
<mxfile host="cli-anything" agent="cli-anything-drawio/1.0.0" version="24.0.0">
  <diagram id="diagram_tutor_killswitch_01" name="Page-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v_11" value="Tutor Kill-Switch — Corrected Facility-Aware Flow (fixed 2026-08-27)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;autosize=1;fontSize=18;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry" /></mxCell><mxCell id="v_12" value="Old broken flow checked ONLY the statewide feature_flags row, before resolving the user — no per-facility toggle could ever satisfy it (corypride&#x27;s Finding 3)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;autosize=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="24" as="geometry" /></mxCell><mxCell id="v_13" value="Browser clicks &quot;AI Tutor&quot; -&gt; GET /tutor
(ory_kratos_session cookie, via rev_proxy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="480" height="60" as="geometry" /></mxCell><mxCell id="v_14" value="identity.getUser(request)
1. GET $KRATOS_PUBLIC_URL/sessions/whoami (direct on intranet)
2. strict shape check: active===true, identity.id is a real string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="190" width="480" height="70" as="geometry" /></mxCell><mxCell id="v_15" value="session valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="290" width="300" height="70" as="geometry" /></mxCell><mxCell id="v_16" value="401 Unauthenticated
(authMode included so the client
redirects to the right login)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="300" height="50" as="geometry" /></mxCell><mxCell id="v_17" value="SELECT public.users WHERE kratos_id = ? AND deleted_at IS NULL
(row.facility_id must be non-null, or treated as no user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="400" width="480" height="70" as="geometry" /></mxCell><mxCell id="v_18" value="isTutorEnabled(user.facilityId)
— the fix: user resolved FIRST, so facility is known before this check runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="500" width="480" height="50" as="geometry" /></mxCell><mxCell id="v_19" value="facility_feature_flags row
exists for (facility_id, &#x27;ai_tutor&#x27;)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="580" width="340" height="80" as="geometry" /></mxCell><mxCell id="v_20" value="YES -&gt; use the override&#x27;s
enabled value directly
(wins in EITHER direction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="700" width="260" height="60" as="geometry" /></mxCell><mxCell id="v_21" value="NO -&gt; fall back to the
statewide feature_flags.enabled
row (the OLD check&#x27;s only source)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="700" width="260" height="60" as="geometry" /></mxCell><mxCell id="v_22" value="resulting value
enabled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="800" width="300" height="70" as="geometry" /></mxCell><mxCell id="v_23" value="403 &quot;Tutor is not enabled&quot;
(the real kill switch — every
API route goes through this)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="810" width="300" height="50" as="geometry" /></mxCell><mxCell id="v_24" value="mustChangePassword? -&gt; 403 must_change_password
impersonating + write method? -&gt; 403 read_only_impersonation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="910" width="480" height="50" as="geometry" /></mxCell><mxCell id="v_25" value="200 — role-appropriate view
staff -&gt; teacher (auto-landed) | resident -&gt; student
SuperAdmin also gets the Students picker (read-only impersonation)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="1000" width="480" height="60" as="geometry" /></mxCell><mxCell id="v_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="v_13" target="v_14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="v_14" target="v_15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_28" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="v_15" target="v_16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_29" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="v_15" target="v_17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="v_17" target="v_18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="v_18" target="v_19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_32" value="override row found" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="v_19" target="v_20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_33" value="no override" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="v_19" target="v_21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="v_20" target="v_22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="v_21" target="v_22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_36" value="false" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="v_22" target="v_23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_37" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="v_22" target="v_24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v_38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;fontColor=#333333;strokeColor=#333333;" edge="1" parent="1" source="v_24" target="v_25"><mxGeometry relative="1" as="geometry" /></mxCell>
